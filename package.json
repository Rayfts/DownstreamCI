{
  "name": "downstreamci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @downstreamci/core build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm typecheck && pnpm test && pnpm fixtures:test && pnpm lint",
    "fixtures:test": "node scripts/fixture-smoke.mjs",
    "runner:build": "docker build -t downstreamci/runner:local containers/runner"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
